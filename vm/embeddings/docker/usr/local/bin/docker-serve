#!/bin/sh
# docker-serve — long-running container host services, respawned by init.
# Only the user-mode gateway (the monolith daemon, 192.168.127.1) may
# connect to the relays, so containers can't reach them.
#
# docker engine:
#   dockerd:    the Docker daemon (it starts containerd itself)
#   relay:      forwards TCP port 2375 to dockerd's socket for the host
# containerd engine:
#   containerd: the containerd daemon
#   buildkitd:  BuildKit on containerd, for `nerdctl build`
#   sshd:       internal sshd the host runs nerdctl through
#   ports:      answers TCP port 2377 with `nerdctl ps --format json`
# both, when Kubernetes is on (otherwise they sleep):
#   k3s:        single-node k3s server on the VM's engine
#   k8s-info:   answers TCP port 2378 with k3s's kubeconfig or services
# both:
#   power:      powers off cleanly when the VM's power button is pressed
#               (Virtualization.framework's stop request): GPIO line 6 of
#               the PL061 controller, as described by the device tree's
#               gpio-keys node. Alpine's kernel has no gpio_keys driver, so
#               gpiomon watches the line instead.
#   shutdown:   run by init on poweroff, before it kills everything: stops
#               k3s and the engine so containers exit cleanly, then syncs.
#   listening:  answers TCP port 2380 with /proc/net/tcp{,6}, so the host
#               can forward whatever sandbox processes listen on
#   fsnotify:   answers TCP port 2379 with a loop that touches each path
#               sent to it, so files changed on the Mac raise inotify events
#               for watchers in the VM and its containers.
#   clock:      keeps the system clock in step with the RTC, which follows
#               the Mac's clock. After a restore from `monolith docker pause`
#               the system clock is behind by however long the VM was paused.

SOCK=/var/run/docker.sock
GUEST=192.168.127.2
GATEWAY=192.168.127.1/32
K3S=/opt/monolith/k3s/k3s
ENGINE=$(cat /etc/monolith-engine 2>/dev/null || echo docker)

# need exits (to be respawned after a pause) if the engine isn't installed,
# so init doesn't spin.
need() {
	if ! command -v "$1" >/dev/null; then
		sleep 5
		exit 1
	fi
}

# k8s_or_idle parks a Kubernetes service for good when k3s isn't shared in.
k8s_or_idle() {
	[ -x "$K3S" ] || exec sleep 2147483647
}

case "$1" in
dockerd)
	need dockerd
	exec dockerd --host="unix://$SOCK" >>/var/log/docker.log 2>&1
	;;
relay)
	while [ ! -S "$SOCK" ]; do
		sleep 1
	done
	# -t: after one side half-closes (stdin EOF), keep relaying the other
	# until it ends; socat's default closes everything after 0.5s.
	exec socat -t 86400 TCP-LISTEN:2375,bind=$GUEST,range=$GATEWAY,reuseaddr,fork "UNIX-CONNECT:$SOCK"
	;;
containerd)
	need containerd
	exec containerd >>/var/log/containerd.log 2>&1
	;;
buildkitd)
	need buildkitd
	ns=default
	[ -x "$K3S" ] && ns=k8s.io # images built for pods
	exec buildkitd --oci-worker=false --containerd-worker=true --containerd-worker-namespace=$ns >>/var/log/buildkitd.log 2>&1
	;;
sshd)
	need sshd
	exec /usr/sbin/sshd -D -e -f /etc/ssh/monolith_sshd_config >>/var/log/sshd.log 2>&1
	;;
ports)
	need nerdctl
	exec socat TCP-LISTEN:2377,bind=$GUEST,range=$GATEWAY,reuseaddr,fork "EXEC:/usr/local/bin/docker-serve ports-list"
	;;
ports-list)
	exec nerdctl ps --format json 2>/dev/null
	;;
k3s)
	k8s_or_idle
	if [ "$ENGINE" = containerd ]; then
		while [ ! -S /run/containerd/containerd.sock ]; do sleep 1; done
		runtime=--container-runtime-endpoint=unix:///run/containerd/containerd.sock
	else
		while [ ! -S "$SOCK" ]; do sleep 1; done
		runtime=--docker
	fi
	exec "$K3S" server $runtime --disable=traefik --node-name="$(hostname)" \
		--write-kubeconfig-mode=600 >>/var/log/k3s.log 2>&1
	;;
k8s-info)
	k8s_or_idle
	exec socat TCP-LISTEN:2378,bind=$GUEST,range=$GATEWAY,reuseaddr,fork "EXEC:/usr/local/bin/docker-serve k8s-info-reply"
	;;
k8s-info-reply)
	read -r what
	case "$what" in
	kubeconfig) exec cat /etc/rancher/k3s/k3s.yaml ;;
	services) exec "$K3S" kubectl get svc -A -o json ;;
	esac
	;;
power)
	need gpiomon
	gpiomon --edges=rising --num-events=1 -c gpiochip0 6 >/dev/null || exit 1
	echo "docker-serve: power button pressed, shutting down" >/dev/console
	exec poweroff
	;;
shutdown)
	# Stop k3s first so it doesn't restart pods while the engine stops.
	pkill -TERM -x k3s 2>/dev/null
	stop_wait() { # stop_wait <process> <seconds>
		pkill -TERM -x "$1" 2>/dev/null || return 0
		i=0
		while pgrep -x "$1" >/dev/null && [ $i -lt "$2" ]; do
			sleep 1
			i=$((i + 1))
		done
	}
	if [ "$ENGINE" = containerd ]; then
		for ns in default k8s.io; do
			ids=$(nerdctl -n $ns ps -q 2>/dev/null)
			[ -n "$ids" ] && nerdctl -n $ns stop -t 10 $ids >/dev/null 2>&1
		done
		stop_wait buildkitd 5
		stop_wait containerd 10
	else
		# dockerd stops its containers (10s each, in parallel) on SIGTERM.
		stop_wait dockerd 20
	fi
	stop_wait k3s 5
	sync
	;;
fsnotify)
	exec socat TCP-LISTEN:2379,bind=$GUEST,range=$GATEWAY,reuseaddr,fork "EXEC:/usr/local/bin/docker-serve touch-paths"
	;;
listening)
	exec socat TCP-LISTEN:2380,bind=$GUEST,range=$GATEWAY,reuseaddr,fork "EXEC:cat /proc/net/tcp /proc/net/tcp6"
	;;
touch-paths)
	if grep -q 'monolith\.sandbox=' /proc/cmdline; then
		# A sandbox's repo is an overlay on the Mac's copy, which caches
		# the Mac's files. Touching would copy them into the writable layer
		# for good; drop the caches instead (once per burst of changes) so
		# the overlay reads the Mac's new content.
		while IFS= read -r path; do
			while IFS= read -r -t 1 path; do :; done
			echo 2 >/proc/sys/vm/drop_caches
		done
		exit 0
	fi
	# Touch in place: the times stay as the Mac set them, the inotify
	# IN_ATTRIB event is what watchers need.
	while IFS= read -r path; do
		[ -e "$path" ] && touch -c -r "$path" "$path"
	done
	;;
clock)
	while sleep 2; do
		rtc=$(cat /sys/class/rtc/rtc0/since_epoch) || exit 1
		drift=$((rtc - $(date +%s)))
		if [ "$drift" -gt 2 ] || [ "$drift" -lt -2 ]; then
			hwclock -s -u
		fi
	done
	;;
*)
	echo "usage: docker-serve dockerd|relay|containerd|buildkitd|sshd|ports|k3s|k8s-info|power|shutdown|fsnotify|listening|clock" >&2
	exit 2
	;;
esac
