#!/bin/sh
# docker-serve — long-running docker host services, respawned by init.
#   dockerd: the Docker daemon (it starts containerd itself)
#   relay:   forwards TCP port 2375 to dockerd's socket for the host. Only
#            the user-mode gateway (the monolith daemon) may connect, so
#            containers can't reach dockerd through it.
#   clock:   keeps the system clock in step with the RTC, which follows the
#            Mac's clock. After a restore from `monolith docker pause` the
#            system clock is behind by however long the VM was paused.

SOCK=/var/run/docker.sock

case "$1" in
dockerd)
	if ! command -v dockerd >/dev/null; then
		sleep 5
		exit 1
	fi
	exec dockerd --host="unix://$SOCK" >>/var/log/docker.log 2>&1
	;;
relay)
	while [ ! -S "$SOCK" ]; do
		sleep 1
	done
	# -t: after one side half-closes (stdin EOF), keep relaying the other
	# until it ends; socat's default closes everything after 0.5s.
	exec socat -t 86400 TCP-LISTEN:2375,bind=192.168.127.2,range=192.168.127.1/32,reuseaddr,fork "UNIX-CONNECT:$SOCK"
	;;
clock)
	while sleep 2; do
		rtc=$(cat /sys/class/rtc/rtc0/since_epoch) || exit 1
		drift=$((rtc - $(date +%s)))
		if [ "$drift" -gt 2 ] || [ "$drift" -lt -2 ]; then
			hwclock -s -u
		fi
	done
	;;
*)
	echo "usage: docker-serve dockerd|relay|clock" >&2
	exit 2
	;;
esac
