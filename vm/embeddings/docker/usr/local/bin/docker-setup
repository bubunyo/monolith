#!/bin/sh
# docker-setup — prepares the monolith container host on every boot.
# The first boot installs the engine from the Alpine repositories. The
# engine is docker unless the containerd overlay wrote /etc/monolith-engine.

ENGINE=$(cat /etc/monolith-engine 2>/dev/null || echo docker)
DATA_DISK=/dev/vdb
# Kubernetes is on when the host passes monolith.k3s=1 and shares the k3s
# binary (virtio-fs tag k3s).
K8S=$(tr ' ' '\n' </proc/cmdline | grep -cx 'monolith\.k3s=1')
K3S_DIR=/opt/monolith/k3s
# Rosetta runs x86-64 binaries when the host passes monolith.rosetta=1 and
# shares Rosetta (virtio-fs tag rosetta).
ROSETTA=$(tr ' ' '\n' </proc/cmdline | grep -cx 'monolith\.rosetta=1')

# libgpiod's gpiomon watches the power button (docker-serve power).
case "$ENGINE" in
containerd)
	PACKAGES="containerd nerdctl cni-plugins buildkit buildctl iptables ip6tables openssh-server socat e2fsprogs libgpiod"
	NEEDED="containerd nerdctl buildkitd sshd socat mkfs.ext4 gpiomon"
	;;
*)
	PACKAGES="docker socat e2fsprogs libgpiod"
	NEEDED="dockerd socat mkfs.ext4 gpiomon"
	;;
esac

echo "docker-setup: preparing $ENGINE host"

mkdir -p /sys/fs/cgroup
mount -t cgroup2 cgroup2 /sys/fs/cgroup

# gpio-pl061 drives the GPIO controller the VM's power button is wired to.
modprobe -a overlay br_netfilter veth virtiofs gpio-pl061 binfmt_misc 2>/dev/null
sysctl -qw net.ipv4.ip_forward=1

for cmd in $NEEDED; do
	if ! command -v "$cmd" >/dev/null; then
		echo "docker-setup: installing $PACKAGES (first boot)"
		until apk add --no-cache $PACKAGES; do
			echo "docker-setup: apk failed, retrying in 5s"
			sleep 5
		done
		sync # a forced stop right after must not leave empty files
		break
	fi
done

# Images and containers live on their own sparse disk, formatted on first use.
if ! blkid "$DATA_DISK" | grep -q 'TYPE="ext4"'; then
	echo "docker-setup: formatting $DATA_DISK"
	mkfs.ext4 -q -L docker "$DATA_DISK"
fi
if [ "$ENGINE" = containerd ]; then
	# containerd, nerdctl and buildkit each keep state under /var/lib.
	mkdir -p /data
	mount -t ext4 "$DATA_DISK" /data
	for dir in containerd nerdctl buildkit; do
		mkdir -p "/data/$dir" "/var/lib/$dir"
		mount --bind "/data/$dir" "/var/lib/$dir"
	done
else
	mkdir -p /var/lib/docker
	mount -t ext4 "$DATA_DISK" /var/lib/docker
fi

if [ "$ENGINE" = containerd ]; then
	# Internal sshd for `monolith docker nerdctl`: root's key comes from the
	# kernel command line (monolith.ssh_pubkey), host keys are made once.
	key=$(tr ' ' '\n' </proc/cmdline | sed -n 's/^monolith\.ssh_pubkey=//p')
	mkdir -p /root/.ssh
	chmod 700 /root/.ssh
	echo "ssh-ed25519 $key monolith" >/root/.ssh/authorized_keys
	chmod 600 /root/.ssh/authorized_keys
	ssh-keygen -A >/dev/null
	# sshd only admits root@gateway with the key; keep containers from even
	# reaching it.
	iptables -I INPUT -p tcp -d 192.168.127.2 --dport 22 ! -s 192.168.127.1 -j REJECT
fi

if [ "$ENGINE" = containerd ]; then
	# nerdctl and BuildKit use containerd's k8s.io namespace when Kubernetes
	# is on, so images they build are visible to pods.
	echo 'cni_path = "/usr/libexec/cni"' >/etc/nerdctl/nerdctl.toml
	[ "$K8S" = 1 ] && echo 'namespace = "k8s.io"' >>/etc/nerdctl/nerdctl.toml
	# containerd's CRI takes pod networking from k3s (flannel) when
	# Kubernetes is on, else from the stock CNI setup.
	if [ "$K8S" = 1 ]; then
		sed -i -e "s|bin_dir = '/usr/libexec/cni'|bin_dir = '/var/lib/rancher/k3s/data/current/bin'|" \
			-e "s|conf_dir = '/etc/cni/net.d'|conf_dir = '/var/lib/rancher/k3s/agent/etc/cni/net.d'|" /etc/containerd/config.toml
	else
		sed -i -e "s|bin_dir = '/var/lib/rancher/k3s/data/current/bin'|bin_dir = '/usr/libexec/cni'|" \
			-e "s|conf_dir = '/var/lib/rancher/k3s/agent/etc/cni/net.d'|conf_dir = '/etc/cni/net.d'|" /etc/containerd/config.toml
	fi
fi

if [ "$K8S" = 1 ]; then
	echo "docker-setup: preparing Kubernetes (k3s)"
	modprobe -a vxlan 2>/dev/null
	mount --make-rshared /
	mkdir -p "$K3S_DIR"
	mount -t virtiofs -o ro k3s "$K3S_DIR" || echo "docker-setup: mounting k3s failed"
	# k3s and kubelet state go on the data disk.
	if [ "$ENGINE" = containerd ]; then
		base=/data
	else
		base=/var/lib/docker/.monolith
	fi
	for dir in rancher kubelet; do
		mkdir -p "$base/$dir" "/var/lib/$dir"
		mount --bind "$base/$dir" "/var/lib/$dir"
	done
fi

if [ "$ROSETTA" = 1 ]; then
	# Register Rosetta for x86-64 ELF binaries: flag F opens the
	# interpreter now, so it works inside containers too; C keeps setuid.
	# printf %s keeps the \x escapes literal; the kernel decodes them.
	mkdir -p /mnt/rosetta
	mount -t virtiofs -o ro rosetta /mnt/rosetta || echo "docker-setup: mounting rosetta failed"
	mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc 2>/dev/null
	if [ ! -e /proc/sys/fs/binfmt_misc/rosetta ]; then
		printf '%s\n' ':rosetta:M::\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00:\xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff:/mnt/rosetta/rosetta:CF' >/proc/sys/fs/binfmt_misc/register
	fi
fi

if tr ' ' '\n' </proc/cmdline | grep -q '^monolith\.sandbox='; then
	# A sandbox gets only its repo (read-only, overlaid), never /Users.
	/usr/local/bin/sandbox-mount || echo "docker-setup: mounting the sandbox repo failed"
else
	# The Mac's /Users, at the same path, so bind mounts like -v ~/src:/src work.
	mkdir -p /Users
	mount -t virtiofs users /Users || echo "docker-setup: mounting /Users failed"
fi

echo "docker-setup: done"
