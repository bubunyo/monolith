# /etc/inittab — busybox init for the monolith cluster VM
# Alpine initramfs already mounts proc, sysfs, devtmpfs and root (ro).
::sysinit:/bin/mount -o remount,rw /
::sysinit:/bin/mkdir -p /dev/pts /dev/shm /run /tmp
::sysinit:/bin/mount -t devpts devpts /dev/pts
::sysinit:/bin/mount -t tmpfs tmpfs /dev/shm
::sysinit:/bin/mount -t tmpfs tmpfs /run
::sysinit:/bin/mount -t tmpfs tmpfs /tmp
::sysinit:/sbin/mdev -s
::sysinit:/bin/chmod 666 /dev/null /dev/zero /dev/urandom /dev/random /dev/tty
::sysinit:/bin/hostname {{.Name}}

# Kernel modules from the modloop squashfs, as in ../../etc/inittab.tmpl.
::sysinit:/bin/mkdir -p /.modloop
::sysinit:/bin/mount -t squashfs -o ro /lib/modloop-virt /.modloop
::sysinit:/bin/rm -rf /lib/modules
::sysinit:/bin/ln -s /.modloop/modules /lib/modules

# Boot steps for `vm run` (see vm/bootsteps.go): an OSC sequence on the
# console, which terminals ignore. The quotes make init run it with sh,
# whose builtin printf decodes the escapes.
::sysinit:printf '\033]7777;monolith;network\007'
::sysinit:/sbin/modprobe af_packet
::sysinit:/sbin/ifconfig lo 127.0.0.1 up
::sysinit:/sbin/ifconfig eth0 up
::sysinit:/usr/local/bin/dhcp-configure eth0
::sysinit:printf '\033]7777;monolith;setup\007'

# Installs the packages k3s needs on first boot, then mounts the data disk
# and the host shares.
::sysinit:/usr/local/bin/cluster-setup
::sysinit:printf '\033]7777;monolith;ready\007'

# k3s, the clock sync that corrects the time after a restore, the power
# button, and image loads.
::respawn:/usr/local/bin/cluster-serve k3s
::respawn:/usr/local/bin/cluster-serve clock
::respawn:/usr/local/bin/cluster-serve power
::respawn:/usr/local/bin/cluster-serve load

hvc0::respawn:/sbin/getty -n -l /usr/local/bin/autologin 0 hvc0

::ctrlaltdel:/sbin/reboot
# Stop k3s cleanly before init kills everything and unmounts.
::shutdown:/usr/local/bin/cluster-serve shutdown
::shutdown:/bin/umount -a -r
